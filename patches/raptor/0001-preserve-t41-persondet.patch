diff --git a/Makefile b/Makefile
index 013cc1f..d478fb3 100644
--- a/Makefile
+++ b/Makefile
@@ -179,12 +179,42 @@ endif
 LDFLAGS_HAL := $(LDFLAGS_SYSROOT) $(SHIM_LIB) -limp -lalog -lpthread -lrt -lm -ldl -latomic
 
 # IVS detection libs
+
 ifeq ($(IVS_DETECT),1)
 CFLAGS += -DIVS_DETECT
+
+ifeq ($(JZDL),1)
+CFLAGS += -DJZDL
 LDFLAGS_HAL += -ljzdl.m $(LINK_STDCXX)
+endif
+
 ifeq ($(PERSONDET),1)
 CFLAGS += -DPERSONDET
-LDFLAGS_HAL += -lpersonDet_inf -ljzdl -Wl,--no-as-needed -lmxu_core -lmxu_imgproc -lmxu_merge -lmxu_video -Wl,--as-needed
+
+ifeq ($(PLATFORM),T41)
+LDFLAGS_HAL += -Wl,--no-as-needed \
+    $(LINK_STDCXX) \
+    -lmxu_core \
+    -lmxu_imgproc \
+    -lmxu_merge \
+    -lmxu_video \
+    -laip \
+    -ldrivers \
+    -lvenus \
+    -lpersonvehiclepetDet_inf \
+    -limp \
+    -lalog \
+    -Wl,--as-needed
+else
+LDFLAGS_HAL += -lpersonDet_inf -ljzdl \
+	-Wl,--no-as-needed \
+	-lmxu_core \
+	-lmxu_imgproc \
+	-lmxu_merge \
+	-lmxu_video \
+	-Wl,--as-needed
+endif
+
 endif
 endif
 LDFLAGS     := $(LDFLAGS_SYSROOT) -lpthread -lrt -latomic
