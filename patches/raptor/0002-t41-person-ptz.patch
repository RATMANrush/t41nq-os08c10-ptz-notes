diff --git a/rvd/rvd_ptz.c b/rvd/rvd_ptz.c
new file mode 100644
index 0000000..a14c067
--- /dev/null
+++ b/rvd/rvd_ptz.c
@@ -0,0 +1,145 @@
+/* Optional T41 person-following backend.  Disabled unless motion.ptz_tracking
+ * is explicitly enabled.  It uses the existing vendor /dev/motor ABI and does
+ * not alter the camera's calibrated direction or step settings. */
+#include "rvd.h"
+
+#include <fcntl.h>
+#include <errno.h>
+#include <sys/file.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <string.h>
+
+#define MOTOR_DEV "/dev/motor"
+#define MOTOR_LOCK "/run/motors.lock"
+#define MOTOR_ACTIVE "/run/motors-active"
+#define PAN_MAX 1020
+#define TILT_MAX 240
+#define MOTOR_ABSOLUTE (0xC0046D00UL + 0x03)
+#define MOTOR_GET_POSITION (0xC0046D00UL + 0x04)
+
+struct motor_xy { int x; int y; };
+
+static void motor_active(bool on)
+{
+        if (on) {
+                int fd = open(MOTOR_ACTIVE, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+                if (fd >= 0) {
+                        (void)write(fd, "1\n", 2);
+                        close(fd);
+                }
+        } else {
+                (void)unlink(MOTOR_ACTIVE);
+        }
+}
+
+static int clampi(int v, int lo, int hi)
+{
+        return v < lo ? lo : (v > hi ? hi : v);
+}
+
+int rvd_ptz_init(rvd_state_t *st)
+{
+        st->ptz_fd = -1;
+        st->ptz_lock_fd = -1;
+        st->ptz_tracking = rss_config_get_bool(st->cfg, "motion", "ptz_tracking", false);
+        st->ptz_last_us = 0;
+        if (!st->ptz_tracking)
+                return RSS_OK;
+
+        st->ptz_fd = open(MOTOR_DEV, O_RDWR | O_CLOEXEC);
+        st->ptz_lock_fd = open(MOTOR_LOCK, O_RDWR | O_CREAT, 0666);
+        if (st->ptz_fd < 0 || st->ptz_lock_fd < 0) {
+                RSS_WARN("PTZ: tracking enabled but /dev/motor is unavailable");
+                if (st->ptz_fd >= 0) close(st->ptz_fd);
+                if (st->ptz_lock_fd >= 0) close(st->ptz_lock_fd);
+                st->ptz_fd = st->ptz_lock_fd = -1;
+                st->ptz_tracking = false;
+                return RSS_OK;
+        }
+
+        struct motor_xy p = {510, 120};
+        if (ioctl(st->ptz_fd, MOTOR_GET_POSITION, &p) == 0) {
+                st->ptz_x = clampi(p.x, 0, PAN_MAX);
+                st->ptz_y = clampi(p.y, 0, TILT_MAX);
+        } else {
+                st->ptz_x = 510;
+                st->ptz_y = 120;
+        }
+        RSS_INFO("PTZ: person tracking enabled at %d,%d", st->ptz_x, st->ptz_y);
+        return RSS_OK;
+}
+
+void rvd_ptz_deinit(rvd_state_t *st)
+{
+        if (st->ptz_fd >= 0) close(st->ptz_fd);
+        if (st->ptz_lock_fd >= 0) close(st->ptz_lock_fd);
+        st->ptz_fd = st->ptz_lock_fd = -1;
+}
+
+void rvd_ptz_update(rvd_state_t *st)
+{
+        if (!st->ptz_tracking || st->ptz_fd < 0)
+                return;
+
+        int64_t now = rss_timestamp_us();
+        if (st->ptz_last_us && now - st->ptz_last_us < 200000)
+                return;
+
+        rss_ivs_detect_result_t snap;
+        pthread_mutex_lock(&st->ivs_det_lock);
+        snap = st->ivs_detections;
+        pthread_mutex_unlock(&st->ivs_det_lock);
+        if (snap.count <= 0)
+                return;
+
+        int best = 0;
+        for (int i = 1; i < snap.count; i++)
+                if (snap.detections[i].confidence > snap.detections[best].confidence)
+                        best = i;
+
+        int b[4];
+        memcpy(b, &snap.detections[best].box, sizeof(b));
+        int w = (int)st->streams[1].enc_cfg.width;
+        int h = (int)st->streams[1].enc_cfg.height;
+        if (w <= 0 || h <= 0)
+                return;
+
+        int cx = (b[0] + b[2]) / 2;
+        int cy = (b[1] + b[3]) / 2;
+        int ex = cx - w / 2;
+        int ey = cy - h / 2;
+        RSS_DEBUG("PTZ: bbox %d,%d,%d,%d frame %dx%d error %d,%d",
+                  b[0], b[1], b[2], b[3], w, h, ex, ey);
+        int dead_x = w / 10;
+        int dead_y = h / 10;
+        int dx = 0, dy = 0;
+        if (ex > dead_x) dx = 8;
+        else if (ex < -dead_x) dx = -8;
+        if (ey > dead_y) dy = -4; /* image down = calibrated tilt down (Y-) */
+        else if (ey < -dead_y) dy = 4;
+        if (!dx && !dy)
+                return;
+
+        struct motor_xy target = {
+                clampi(st->ptz_x + dx, 0, PAN_MAX),
+                clampi(st->ptz_y + dy, 0, TILT_MAX),
+        };
+        if (target.x == st->ptz_x && target.y == st->ptz_y)
+                return;
+
+        if (flock(st->ptz_lock_fd, LOCK_EX) < 0)
+                return;
+        motor_active(true);
+        if (ioctl(st->ptz_fd, MOTOR_ABSOLUTE, &target) == 0) {
+                st->ptz_x = target.x;
+                st->ptz_y = target.y;
+                st->ptz_last_us = now;
+                RSS_DEBUG("PTZ: target %d,%d from box %d,%d,%d,%d", target.x, target.y,
+                          b[0], b[1], b[2], b[3]);
+        } else {
+                RSS_WARN("PTZ: MOTOR_ABSOLUTE failed: %s", strerror(errno));
+        }
+        motor_active(false);
+        flock(st->ptz_lock_fd, LOCK_UN);
+}
