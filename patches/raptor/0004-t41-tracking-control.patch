+    if (!enabled || st->ptz_fd >= 0) return;
+    int64_t now = rss_timestamp_us();
+    if (now < st->ptz_retry_us) return;
+    st->ptz_retry_us = now + 2000000;
+    int fd = open("/dev/motor", O_RDWR | O_CLOEXEC);
+    if (fd < 0) return; /* S35 loads the motor after Raptor has started. */
+    int lock = open("/run/motors.lock", O_RDWR | O_CREAT | O_CLOEXEC, 0666);
+    if (lock < 0) { close(fd); return; }
+    st->ptz_fd = fd; st->ptz_lock_fd = lock;
+    RSS_INFO("PTZ: person tracking motor ready");
